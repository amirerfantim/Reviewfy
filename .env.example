# Copy to `.env` in the repository root (next to manage.py).
# These values suit Docker Compose. To run without Docker, change REDIS_HOST,
# both Redis URLs and POSTGRES_HOST to localhost (see the README).

# redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_LOCATION=redis://redis:6379/2

# app: a rating at or above this suspicion factor is treated as suspicious
SUSPICION_THRESHOLD=0.2

# celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=UTC

# django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgresql
POSTGRES_DB=reviewfy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# cache
CACHE_ENABLED=True
CACHE_DEFAULT_TIMEOUT=100
ARTICLES_LIST_CACHE_TIMEOUT=60

# jwt: access token lifetime in minutes, refresh token lifetime in days
JWT_ACCESS_TOKEN_LIFETIME=720
JWT_REFRESH_TOKEN_LIFETIME=7
